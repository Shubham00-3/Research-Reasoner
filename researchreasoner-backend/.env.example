PORT=3002
NODE_ENV=development
JSON_BODY_LIMIT=10mb
RATE_LIMIT_PER_MINUTE=120

# Free: Neo4j Community / Desktop
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_me

# OPTIONAL LLM (both free). Leave both empty → extractive chunk RAG (still good).
# 1) Local Ollama: install https://ollama.com then `ollama pull llama3.2`
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# 2) Free Groq cloud tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

DEMO_MODE=false
DEMO_PAPER_COUNT=25
MAX_PAPERS_PER_SEARCH=80
AUTO_DOWNLOAD_ON_SEARCH=false

# Keep false — PDFs live on disk under ./downloads, not base64 in Neo4j
STORE_PDF_IN_NEO4J=false

# Conversations + caches: in-memory only (no Redis)
